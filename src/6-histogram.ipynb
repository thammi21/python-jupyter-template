   "outputs": [],
   "source": [
   import matplotlib.pyplot as plt

# Data for the histogram
data = [1, 2, 2, 3, 3, 3, 4, 4, 4, 4, 5]

# Create the histogram
plt.figure(figsize=(8, 6))  # Set figure size
plt.hist(data, bins=5, color='skyblue', edgecolor='black')  # Histogram with custom color and edge

# Add title and labels
plt.title("Customized Histogram", fontsize=14)  # Plot title
plt.xlabel("Data Values", fontsize=12)         # X-axis label
plt.ylabel("Frequency", fontsize=12)           # Y-axis label

# Show the plot
plt.show()

   ]
