    "### Exercise 2: Bar Plot with Colors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    import matplotlib.pyplot as plt

# Data for the bar plot
categories = ['A', 'B', 'C', 'D']
values = [5, 7, 3, 9]
colors = ['red', 'blue', 'green', 'orange']  # Colors for each bar

# Create the bar plot
plt.figure(figsize=(8, 6))  # Set figure size
plt.bar(categories, values, color=colors)  # Bar plot with custom colors

# Add title and labels
plt.title("Bar Plot of Categories", fontsize=14)  # Plot title
plt.xlabel("Categories", fontsize=12)            # X-axis label
plt.ylabel("Values", fontsize=12)                # Y-axis label

# Show the plot
plt.show()

