   "outputs": [],
   "source": [import matplotlib.pyplot as plt

# Data for the scatter plot
x = [1, 2, 3, 4, 5]
y = [2, 4, 6, 8, 10]

# Create the scatter plot
plt.figure(figsize=(8, 6))  # Set figure size
plt.scatter(x, y, color='blue', s=100, label='Points')  # Scatter plot with blue dots

# Add annotations for each point
for i in range(len(x)):
    plt.text(x[i], y[i] + 0.3, f'({x[i]}, {y[i]})', fontsize=10, ha='center')  # Annotate each point

# Add title, labels, and legend
plt.title("Scatter Plot with Annotations", fontsize=14)  # Plot title
plt.xlabel("X Values", fontsize=12)                     # X-axis label
plt.ylabel("Y Values", fontsize=12)                     # Y-axis label
plt.legend(fontsize=10)                                 # Display legend

# Show the plot
plt.show()

