    "### Exercise 1: Line Plot Customization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [import matplotlib.pyplot as plt
import numpy as np

# Generate data
x = np.linspace(0, 10, 100)  # x values from 0 to 10
y = x**2                     # y values as the square of x

# Create the plot
plt.figure(figsize=(8, 6))    # Set the figure size
plt.plot(x, y, label="y = x^2", color="blue", linewidth=2)  # Line plot with label and customizations

# Add title and axis labels
plt.title("Line Plot of y = x^2", fontsize=14)   # Plot title
plt.xlabel("X Values", fontsize=12)             # X-axis label
plt.ylabel("Y Values (x^2)", fontsize=12)       # Y-axis label

# Add a grid and legend
plt.grid(True, linestyle="--", alpha=0.6)       # Grid with dashed lines
plt.legend(fontsize=10)                         # Display the legend

# Show the plot
plt.show()

   ]
