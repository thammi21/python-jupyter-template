   "outputs": [],
   "source": [
   import matplotlib.pyplot as plt
import numpy as np

# Data for plots
x = np.linspace(0, 10, 50)             # Line plot data
y = x**2                               # Line plot data
categories = ['A', 'B', 'C', 'D']      # Bar and Pie chart categories
values = [5, 7, 3, 9]                  # Bar chart values
scatter_x = [1, 2, 3, 4, 5]            # Scatter plot data
scatter_y = [2, 4, 6, 8, 10]           # Scatter plot data
pie_labels = ['Python', 'Java', 'C++', 'JavaScript']  # Pie chart labels
pie_sizes = [40, 25, 20, 15]           # Pie chart sizes

# Create the subplot layout
plt.figure(figsize=(12, 10))  # Set figure size

# First subplot: Line plot
plt.subplot(2, 2, 1)  # 2x2 grid, first subplot
plt.plot(x, y, color='blue', linewidth=2)
plt.title("Line Plot")
plt.xlabel("X")
plt.ylabel("Y")

# Second subplot: Bar chart
plt.subplot(2, 2, 2)  # 2x2 grid, second subplot
plt.bar(categories, values, color=['red', 'blue', 'green', 'orange'])
plt.title("Bar Chart")
plt.xlabel("Categories")
plt.ylabel("Values")

# Third subplot: Scatter plot
plt.subplot(2, 2, 3)  # 2x2 grid, third subplot
plt.scatter(scatter_x, scatter_y, color='purple', s=100)
plt.title("Scatter Plot")
plt.xlabel("X Values")
plt.ylabel("Y Values")

# Fourth subplot: Pie chart
plt.subplot(2, 2, 4)  # 2x2 grid, fourth subplot
plt.pie(pie_sizes, labels=pie_labels, autopct='%1.1f%%', startangle=140, colors=['gold', 'skyblue', 'lightgreen', 'coral'])
plt.title("Pie Chart")

# Adjust layout to prevent overlap
plt.tight_layout()

# Show the plot
plt.show()

