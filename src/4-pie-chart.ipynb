    "### Exercise 4: Pie Chart with Percentages"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
   import matplotlib.pyplot as plt

# Data for the pie chart
labels = ['Python', 'Java', 'C++', 'JavaScript']
sizes = [40, 25, 20, 15]
colors = ['gold', 'skyblue', 'lightgreen', 'coral']  # Optional: Custom colors for slices

# Create the pie chart
plt.figure(figsize=(8, 6))  # Set figure size
plt.pie(
    sizes, 
    labels=labels, 
    autopct='%1.1f%%',  # Display percentages with 1 decimal place
    startangle=140,     # Rotate the start angle for better view
    colors=colors,      # Assign colors to slices
    wedgeprops={'edgecolor': 'black'}  # Add black edges to slices
)

# Add a title
plt.title("Pie Chart of Programming Languages", fontsize=14)

# Show the chart
plt.show()

   ]
  }
